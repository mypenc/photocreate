<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- OpenGL ES 3 is the floor; Vulkan is preferred when present. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.level" android:required="false" />
    <!-- Touch is the main input, but a mouse, keyboard or no touchscreen (DeX, Chromebooks) must install. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="CADCraft"
        android:largeHeap="true"
        android:theme="@style/Theme.CADCraft">

        <!-- Restarts the app in a fresh process (crash dialog: Try loading again). -->
        <activity
            android:name=".RestartActivity"
            android:process=":restart"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|smallestScreenSize|density|colorMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing|stateAlwaysHidden">

            <meta-data android:name="android.app.lib_name" android:value="cadcraft_android" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with CADCraft" on a DWG, DXF or DWT drawing. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.dxf" />
                <data android:pathPattern=".*\\.dwg" />
                <data android:pathPattern=".*\\.dwt" />
                <data android:pathPattern=".*\\.svg" />
            </intent-filter>
        </activity>
    </application>
</manifest>
